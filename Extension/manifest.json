{
  "manifest_version": 3,
  "name": "FiltrFeed",
  "version": "0.8.0",
  "description": "Fix your algorithm, smartly",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "css": ["inject.css"],
      "js": ["workit.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icon.jpeg",
    "default_title": "FiltrFeed",
    "default_popup": "index.html"
  }
}
